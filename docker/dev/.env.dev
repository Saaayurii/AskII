# ==================================
# Development Environment Variables
# ==================================

# Secret key for development (use a different one in production!)
SECRET_KEY_BASE=development_secret_key_base_replace_this_in_production

# Frontend URLs for development
FRONTEND_URL=http://localhost:3000
ACTION_CABLE_FRONTEND_URL=ws://localhost:3000/cable

# Default locale
DEFAULT_LOCALE=ru

# Rails environment
RAILS_ENV=development
RACK_TIMEOUT_SERVICE_TIMEOUT=60

# Account signup
ENABLE_ACCOUNT_SIGNUP=true

# Database configuration
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=chatwoot_dev

# Redis configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=redis_dev_password

# Node options
NODE_OPTIONS=--max-old-space-size=4096

# ==================================
# Email configuration (Mailhog)
# ==================================
MAILER_SENDER_EMAIL=СпросиИИ Dev <dev@localhost>
SMTP_DOMAIN=localhost
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_OPENSSL_VERIFY_MODE=none

# ==================================
# AI Configuration (Ollama)
# ==================================
OPENAI_API_KEY=ollama
OPENAI_API_BASE=http://ollama:11434
OPENAI_GPT_MODEL=qwen2.5:3b

# ==================================
# Development flags
# ==================================
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=debug

# Disable asset host in development
ASSET_CDN_HOST=

# ==================================
# Optional: Enable features for testing
# ==================================
# INSTALLATION_NAME=AskII Dev
# LOGO=
# BRAND_NAME=AskII
