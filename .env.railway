# .env.railway
# Шаблон переменных окружения для Railway
# Этот файл НЕ коммитим в git (добавлен в .gitignore)

# =============================================================================
# CORE SETTINGS (ОБЯЗАТЕЛЬНО)
# =============================================================================

# Сгенерируйте через: openssl rand -hex 64
SECRET_KEY_BASE=REPLACE_WITH_128_CHARACTER_RANDOM_STRING

# Railway автоматически установит через railway.toml
FRONTEND_URL=https://YOUR-APP-NAME.up.railway.app

# Основные настройки
RAILS_ENV=production
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=true

# =============================================================================
# DATABASE & CACHE (Railway автоматически)
# =============================================================================

# PostgreSQL - Railway автоматически подставит
POSTGRES_HOST=${{Postgres.PGHOST}}
POSTGRES_USERNAME=${{Postgres.PGUSER}}
POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
POSTGRES_DATABASE=${{Postgres.PGDATABASE}}

# Redis - Railway автоматически подставит
REDIS_URL=${{Redis.REDIS_URL}}

# =============================================================================
# PERFORMANCE OPTIMIZATION (для бесплатного плана)
# =============================================================================

RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
SIDEKIQ_CONCURRENCY=3
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true

# =============================================================================
# EMAIL (ОПЦИОНАЛЬНО - для уведомлений)
# =============================================================================

# Базовые настройки email
MAILER_SENDER_EMAIL=Chatwoot <support@yourdomain.com>
SMTP_DOMAIN=yourdomain.com

# Gmail SMTP (если хотите email уведомления)
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_AUTHENTICATION=login
# SMTP_ENABLE_STARTTLS_AUTO=true

# =============================================================================
# SECURITY & ACCESS
# =============================================================================

# Отключаем регистрацию новых аккаунтов
ENABLE_ACCOUNT_SIGNUP=false

# Push уведомления через Chatwoot серверы
ENABLE_PUSH_RELAY_SERVER=true

# =============================================================================
# ADVANCED (оставьте пустыми для начала)
# =============================================================================

# AI интеграции
# OPENAI_API_KEY=

# Социальные сети
# FB_VERIFY_TOKEN=
# FB_APP_SECRET=
# FB_APP_ID=

# Мониторинг
# SENTRY_DSN=

# Cloud Storage
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=