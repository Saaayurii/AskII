    Нажмите <a href="{{action_url}}">здесь</a>, чтобы просмотреть импортированные контакты.
  </p>
{% else %}
  <p>
  Нажмите <a href="{{ action_url }}" target="_blank">здесь</a>, чтобы просмотреть неудачные записи.
  </p>
{% endif %}
