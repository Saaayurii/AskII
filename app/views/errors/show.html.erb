<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
    opacity: 0;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
    opacity: 0;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
    opacity: 0;
  }

  .space-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .star {
    position: absolute;
    background: white;
    border-radius: 50%;
    animation: twinkle 3s infinite;
  }

  .error-icon {
    font-size: 6rem;
    line-height: 1;
    filter: drop-shadow(0 0 20px rgba(96, 165, 250, 0.5));
  }

  .error-container {
    position: relative;
    z-index: 10;
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
  }

  .error-code {
    font-size: 8rem;
    font-weight: 700;
    background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 1rem 0;
    line-height: 1;
  }

  .error-title {
    font-size: 2rem;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 1rem;
  }

  .error-description {
    font-size: 1.125rem;
    color: #cbd5e1;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .card-container {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 1.5rem;
    padding: 2rem;
    margin-top: 2rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
    color: white;
    text-decoration: none;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.3);
    border: none;
    cursor: pointer;
    margin-bottom: 1rem;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(59, 130, 246, 0.5);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    text-decoration: none;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    border: 2px solid rgba(255, 255, 255, 0.3);
    cursor: pointer;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .warning-box {
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(234, 179, 8, 0.2);
    border: 1px solid rgba(234, 179, 8, 0.3);
    border-radius: 0.75rem;
  }

  .warning-box p {
    font-size: 0.875rem;
    color: #fef08a;
    margin: 0;
  }

  /* Glowing orbs */
  .orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.15;
    animation: pulse-slow 6s ease-in-out infinite;
    z-index: 0;
  }

  .orb1 {
    width: 300px;
    height: 300px;
    background: #3b82f6;
    top: -50px;
    left: -50px;
  }

  .orb2 {
    width: 250px;
    height: 250px;
    background: #8b5cf6;
    bottom: -50px;
    right: -50px;
    animation-delay: 3s;
  }

  @media (max-width: 640px) {
    .error-code {
      font-size: 5rem;
    }

    .error-icon {
      font-size: 4rem;
    }

    .error-title {
      font-size: 1.5rem;
    }

    .error-description {
      font-size: 1rem;
    }

    .error-container {
      padding: 1rem;
    }

    .card-container {
      padding: 1.5rem;
    }
  }
</style>

<!-- Space background -->
<div class="space-background">
  <% 50.times do %>
    <div class="star" style="
      width: <%= rand(1..3) %>px;
      height: <%= rand(1..3) %>px;
      top: <%= rand(0..100) %>%;
      left: <%= rand(0..100) %>%;
      animation-duration: <%= rand(2..5) %>s;
      animation-delay: <%= rand(0..3) %>s;
    "></div>
  <% end %>
</div>

<!-- Glowing orbs -->
<div class="orb orb1"></div>
<div class="orb orb2"></div>

<!-- Main content -->
<div class="error-container">
  <div class="animate-float">
    <% logo_url = GlobalConfig.get_value('LOGO') || GlobalConfig.get_value('LOGO_THUMBNAIL') rescue nil %>
    <% if logo_url.present? %>
      <img src="<%= logo_url %>" alt="Logo" style="height: 5rem; width: auto; filter: drop-shadow(0 0 20px rgba(96, 165, 250, 0.5));">
    <% else %>
      <div class="error-icon">
        <% case @error_code %>
        <% when 404 %>
          🔍
        <% when 403 %>
          🔒
        <% when 422 %>
          ⚠️
        <% when 500 %>
          💥
        <% else %>
          ⚠️
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="error-code animate-fade-in-up animation-delay-200">
    <%= @error_code %>
  </div>

  <h1 class="error-title animate-fade-in-up animation-delay-400">
    <%= @error_title %>
  </h1>

  <p class="error-description animate-fade-in-up animation-delay-600">
    <%= @error_description %>
  </p>

  <div class="card-container animate-fade-in-up animation-delay-600">
    <a href="/app" class="btn-primary">
      <%= I18n.t('errors.actions.go_home') %>
    </a>

    <button onclick="window.history.back()" class="btn-secondary">
      <%= I18n.t('errors.actions.go_back') %>
    </button>

    <% if @error_code == 500 %>
      <div class="warning-box">
        <p>
          <%= I18n.t('errors.internal_server_error.help_text') %>
        </p>
      </div>
    <% end %>
  </div>
</div>
