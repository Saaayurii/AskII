<!DOCTYPE html>
<html>
  <head>
    <title>Супер-Админ | <%= @global_config['INSTALLATION_NAME'] || 'СпросиИИ' %></title>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
    <style>
      .ai-glow {
        background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
        box-shadow: 0 0 30px rgba(34, 197, 94, 0.3);
      }
      .form-glow:focus {
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2), 0 0 20px rgba(34, 197, 94, 0.1);
      }
      .login-card {
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(34, 197, 94, 0.1);
      }
      .dark .login-card {
        background: rgba(30, 41, 59, 0.95);
        border: 1px solid rgba(34, 197, 94, 0.2);
      }
      .floating {
        animation: float 3s ease-in-out infinite;
      }
      @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
      }
    </style>
  </head>
  <body>
    <div class="h-full w-full antialiased">
      <!-- Animated background -->
      <div class="fixed inset-0 bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 dark:from-slate-900 dark:via-slate-800 dark:to-emerald-900"></div>
      <div class="fixed inset-0 bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="rgb(34 197 94 / 0.1)"%3E%3Cpath d="m0 .5 32 32m-32 0 32-32"%3E%3C/path%3E%3C/svg%3E')] opacity-20"></div>

      <main class="relative flex flex-col min-h-screen w-full py-12 sm:px-6 lg:px-8">
        <!-- Logo and title section -->
        <section class="max-w-md mx-auto text-center floating">
          <div class="mb-8">
            <img src="/brand-assets/logo.svg" alt="СпросиИИ" class="mx-auto h-12 w-auto block dark:hidden">
            <img src="/brand-assets/logo_dark.svg" alt="СпросиИИ" class="mx-auto h-12 w-auto hidden dark:block">
          </div>
          <div class="space-y-2">
            <h1 class="text-4xl font-bold text-slate-900 dark:text-white">
              Добро пожаловать! 🚀
            </h1>
            <p class="text-lg text-slate-600 dark:text-slate-300">
              Панель супер-администратора
            </p>
            <div class="w-16 h-1 ai-glow rounded-full mx-auto"></div>
          </div>
        </section>

        <!-- Login form -->
        <section class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
          <div class="login-card p-8 sm:rounded-2xl sm:shadow-xl">
            <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in') do |f| %>
              <% if flash[:error].present? %>
                <div data-alert class="rounded-lg bg-red-500 p-4 text-white text-sm mb-6 border-l-4 border-red-600">
                  <div class="flex items-center">
                    <span class="mr-2">⚠️</span>
                    <%= flash[:error] %>
                  </div>
                </div>
              <% end %>

              <div class="space-y-6">
                <div class="group">
                  <label for="email_address" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">
                    📧 Электронная почта
                  </label>
                  <div class="relative">
                    <%= f.email_field :email,
                        autofocus: true,
                        autocomplete: "email",
                        placeholder: "admin@example.com",
                        class: "form-glow block w-full rounded-xl border-0 px-4 py-4 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 bg-white/50 dark:bg-slate-700/50 backdrop-blur-sm ring-1 ring-slate-200 dark:ring-slate-600 focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 transition-all duration-200 sm:text-sm outline-none" %>
                  </div>
                </div>

                <div class="group">
                  <label for="password" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">
                    🔐 Пароль
                  </label>
                  <div class="relative">
                    <%= f.password_field :password,
                        autocomplete: "current-password",
                        placeholder: "Введите ваш пароль",
                        class: "form-glow block w-full rounded-xl border-0 px-4 py-4 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 bg-white/50 dark:bg-slate-700/50 backdrop-blur-sm ring-1 ring-slate-200 dark:ring-slate-600 focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 transition-all duration-200 sm:text-sm outline-none" %>
                  </div>
                </div>

                <button type="submit" class="w-full ai-glow rounded-xl py-4 px-6 text-lg font-bold text-white transition-all duration-200 hover:scale-105 hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-green-300 dark:focus:ring-green-500/50">
                  <span class="flex items-center justify-center">
                    <span class="mr-2">⚡</span>
                    Войти в панель
                  </span>
                </button>
              </div>
            <% end %>

            <!-- Footer -->
            <div class="mt-6 text-center">
              <p class="text-xs text-slate-500 dark:text-slate-400">
                Защищено технологией СпросиИИ 🛡️
              </p>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
