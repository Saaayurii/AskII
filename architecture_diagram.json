{
  "system": {
    "name": "СпросиИИ",
    "description": "Платформа поддержки клиентов с интеграцией локального искусственного интеллекта",
    "version": "1.0.0",
    "architecture": "Монолитное Ruby on Rails приложение с микросервисной архитектурой для ИИ",

    "infrastructure": {
      "deployment": {
        "type": "Docker Compose",
        "services": {
          "rails": {
            "description": "Основное Rails приложение",
            "image": "chatwoot-rails:development",
            "port": 3000,
            "responsibilities": [
              "HTTP запросы и API endpoints",
              "Бизнес-логика приложения",
              "Рендеринг веб-интерфейса",
              "Управление сессиями и аутентификацией",
              "Координация между модулями"
            ],
            "dependencies": ["postgres", "redis", "vite", "mailhog", "sidekiq", "ollama"]
          },

          "sidekiq": {
            "description": "Фоновые задачи и обработка очередей",
            "responsibilities": [
              "Асинхронная отправка email и уведомлений",
              "Обработка вебхуков от внешних сервисов",
              "Периодические задачи (cron jobs)",
              "Обработка больших объемов данных",
              "Генерация отчетов",
              "Синхронизация с внешними системами"
            ],
            "dependencies": ["postgres", "redis", "mailhog"]
          },

          "vite": {
            "description": "Фронтенд сервер разработки",
            "port": 3036,
            "responsibilities": [
              "Hot Module Replacement (HMR)",
              "Сборка Vue.js компонентов",
              "Компиляция TypeScript",
              "Обработка Tailwind CSS",
              "Оптимизация ассетов"
            ]
          },

          "postgres": {
            "description": "База данных PostgreSQL 16 с pgvector",
            "image": "pgvector/pgvector:pg16",
            "port": 5432,
            "responsibilities": [
              "Хранение всех данных приложения",
              "Векторный поиск (pgvector) для эмбеддингов",
              "Транзакционная целостность",
              "Индексирование и оптимизация запросов",
              "Репликация и резервное копирование"
            ],
            "extensions": ["pgvector"]
          },

          "redis": {
            "description": "In-memory кэш и брокер сообщений",
            "port": 6379,
            "responsibilities": [
              "Кэширование данных приложения",
              "Хранение очередей Sidekiq",
              "Управление сессиями",
              "Rate limiting",
              "Pub/Sub для real-time уведомлений",
              "Временное хранение данных"
            ]
          },

          "mailhog": {
            "description": "SMTP тестирование для разработки",
            "ports": [1025, 8025],
            "responsibilities": [
              "Перехват исходящих email в dev режиме",
              "Веб-интерфейс для просмотра писем",
              "Тестирование email шаблонов"
            ]
          },

          "ollama": {
            "description": "Локальный сервер ИИ моделей",
            "image": "ollama/ollama:latest",
            "port": 11434,
            "responsibilities": [
              "Хостинг локальных языковых моделей",
              "Обработка запросов к ИИ",
              "Генерация текста и ответов",
              "Векторизация текста для поиска",
              "Inference для Qwen2.5:14b модели"
            ],
            "models": ["qwen2.5:14b", "qwen2.5:3b"],
            "api_endpoint": "http://ollama:11434/v1"
          }
        }
      },

      "storage": {
        "volumes": {
          "postgres": "Данные PostgreSQL",
          "redis": "Данные Redis",
          "chatwoot_ollama_data": "Модели и данные Ollama",
          "bundle": "Ruby gems",
          "node_modules": "NPM пакеты",
          "packs": "Скомпилированные ассеты",
          "cache": "Временный кэш",
          "storage": "Файлы и изображения пользователей"
        }
      }
    },

    "backend": {
      "framework": "Ruby on Rails 7.x",
      "language": "Ruby 3.2+",

      "core_modules": {
        "accounts_module": {
          "description": "Управление аккаунтами организаций",
          "models": ["Account", "AccountUser"],
          "responsibilities": [
            "Создание и управление организациями",
            "Управление пользователями аккаунта",
            "Настройки и конфигурация аккаунта",
            "Биллинг и подписки",
            "Лимиты и квоты"
          ],
          "api_endpoints": [
            "POST /api/v1/accounts - Создание аккаунта",
            "GET /api/v1/accounts/:id - Получение аккаунта",
            "PATCH /api/v1/accounts/:id - Обновление аккаунта"
          ]
        },

        "users_module": {
          "description": "Управление пользователями и аутентификация",
          "models": ["User", "AccountUser"],
          "responsibilities": [
            "Регистрация и вход пользователей",
            "Управление профилями",
            "Роли и права доступа (administrator, agent, viewer)",
            "Сброс паролей",
            "2FA аутентификация",
            "SSO интеграция"
          ],
          "authentication": "Devise + JWT tokens",
          "api_endpoints": [
            "POST /api/v1/auth/signup - Регистрация",
            "POST /api/v1/auth/login - Вход",
            "DELETE /api/v1/auth/logout - Выход"
          ]
        },

        "conversations_module": {
          "description": "Управление разговорами с клиентами",
          "models": ["Conversation", "Message", "ConversationParticipant"],
          "responsibilities": [
            "Создание и управление разговорами",
            "Хранение истории сообщений",
            "Статусы разговоров (open, pending, resolved, snoozed)",
            "Назначение агентов на разговоры",
            "Приоритеты и SLA",
            "Метки и категоризация",
            "Приватные заметки"
          ],
          "statuses": ["open", "pending", "resolved", "snoozed"],
          "api_endpoints": [
            "GET /api/v1/accounts/:account_id/conversations - Список разговоров",
            "GET /api/v1/accounts/:account_id/conversations/:id - Детали разговора",
            "POST /api/v1/accounts/:account_id/conversations/:id/messages - Отправка сообщения",
            "PATCH /api/v1/accounts/:account_id/conversations/:id/toggle_status - Изменение статуса"
          ],
          "integrations": ["captain_assistant", "automation_rules", "webhooks"]
        },

        "messages_module": {
          "description": "Обработка сообщений",
          "models": ["Message", "Attachment"],
          "message_types": {
            "incoming": "Сообщения от клиентов",
            "outgoing": "Ответы агентов",
            "activity": "Системные уведомления",
            "template": "Шаблонные сообщения"
          },
          "responsibilities": [
            "Создание и хранение сообщений",
            "Обработка вложений (изображения, файлы, видео)",
            "Форматирование текста (Markdown, HTML)",
            "Анализ тональности (sentiment analysis)",
            "Интеграция с ИИ для автоответов",
            "Отметки о прочтении"
          ],
          "features": [
            "Rich text редактор",
            "Emoji поддержка",
            "Упоминания @mentions",
            "Ссылки на сообщения",
            "Реакции на сообщения"
          ]
        },

        "contacts_module": {
          "description": "Управление контактами клиентов",
          "models": ["Contact", "ContactInbox"],
          "responsibilities": [
            "Профили клиентов",
            "История взаимодействий",
            "Кастомные атрибуты",
            "Сегментация контактов",
            "Импорт/экспорт контактов",
            "Дедупликация контактов",
            "Блокировка спама"
          ],
          "attributes": [
            "Имя, email, телефон",
            "Местоположение (страна, город)",
            "Социальные профили",
            "Компания и должность",
            "Теги и метки",
            "Пользовательские поля"
          ]
        },

        "inboxes_module": {
          "description": "Управление каналами связи (инбоксы)",
          "models": ["Inbox", "InboxMember", "Channel::*"],
          "channel_types": {
            "web_widget": "Веб-чат на сайте",
            "email": "Email интеграция",
            "facebook": "Facebook Messenger",
            "instagram": "Instagram Direct",
            "twitter": "Twitter DM",
            "whatsapp": "WhatsApp Business",
            "telegram": "Telegram бот",
            "line": "LINE мессенджер",
            "sms": "SMS каналы (Twilio)"
          },
          "responsibilities": [
            "Конфигурация каналов связи",
            "Прием входящих сообщений",
            "Отправка исходящих сообщений",
            "Управление доступом агентов",
            "Автоответчики",
            "Рабочие часы",
            "Предварительные формы"
          ],
          "features": [
            "Мультиканальность",
            "Автоназначение разговоров",
            "Webhook уведомления",
            "CSAT опросы"
          ]
        },

        "agent_bots_module": {
          "description": "Боты и автоматизация",
          "models": ["AgentBot", "AgentBotInbox"],
          "responsibilities": [
            "Создание чат-ботов",
            "Интеграция с Dialogflow",
            "Webhook боты",
            "Handoff к живым агентам",
            "Автоматические ответы"
          ]
        },

        "automation_rules_module": {
          "description": "Правила автоматизации",
          "models": ["AutomationRule"],
          "responsibilities": [
            "Условия и триггеры",
            "Автоматические действия",
            "Назначение агентов",
            "Применение меток",
            "Отправка сообщений",
            "Изменение приоритетов"
          ],
          "triggers": [
            "Создание разговора",
            "Изменение статуса",
            "Назначение агента",
            "Добавление метки",
            "Истечение SLA"
          ],
          "actions": [
            "Назначить агента/команду",
            "Добавить/удалить метки",
            "Отправить email",
            "Отправить сообщение",
            "Изменить приоритет"
          ]
        },

        "canned_responses_module": {
          "description": "Заготовленные ответы",
          "models": ["CannedResponse"],
          "responsibilities": [
            "Шаблоны быстрых ответов",
            "Короткие коды для вставки",
            "Персонализация через переменные",
            "Поиск по шорткодам"
          ]
        },

        "labels_module": {
          "description": "Метки для категоризации",
          "models": ["Label"],
          "responsibilities": [
            "Создание цветных меток",
            "Применение к разговорам",
            "Фильтрация по меткам",
            "Отчеты по меткам",
            "ИИ предложения меток"
          ]
        },

        "teams_module": {
          "description": "Управление командами",
          "models": ["Team", "TeamMember"],
          "responsibilities": [
            "Создание команд агентов",
            "Управление членами команды",
            "Назначение разговоров командам",
            "Отчеты по командам"
          ]
        },

        "campaigns_module": {
          "description": "Маркетинговые кампании",
          "models": ["Campaign"],
          "responsibilities": [
            "Создание кампаний",
            "Сегментация аудитории",
            "Планирование отправки",
            "Триггерные кампании",
            "Аналитика кампаний"
          ],
          "campaign_types": ["one_off", "ongoing"]
        },

        "portals_module": {
          "description": "Порталы самообслуживания (центр знаний)",
          "models": ["Portal", "Category", "Article"],
          "responsibilities": [
            "Создание порталов помощи",
            "Управление категориями",
            "Публикация статей",
            "Поиск по базе знаний",
            "Мультиязычность",
            "SEO оптимизация"
          ],
          "features": [
            "Markdown редактор",
            "Версионирование статей",
            "Публичный/приватный доступ",
            "Виджет на сайте"
          ]
        },

        "integrations_module": {
          "description": "Интеграции с внешними сервисами",
          "models": ["Integrations::*"],
          "supported_integrations": {
            "slack": "Управление разговорами через Slack",
            "dialogflow": "ИИ чат-боты",
            "google_translate": "Автоматический перевод",
            "linear": "Создание тикетов",
            "shopify": "Интеграция с заказами"
          },
          "responsibilities": [
            "OAuth аутентификация",
            "Синхронизация данных",
            "Webhook обработка",
            "API коммуникация"
          ]
        },

        "reports_module": {
          "description": "Аналитика и отчеты",
          "responsibilities": [
            "Отчеты по разговорам",
            "Метрики агентов (response time, resolution time)",
            "Отчеты по инбоксам",
            "Отчеты по меткам",
            "CSAT аналитика",
            "Экспорт в CSV",
            "Дашборды в реальном времени"
          ],
          "metrics": [
            "First response time",
            "Average resolution time",
            "Number of conversations",
            "CSAT score",
            "Agent utilization"
          ]
        },

        "webhooks_module": {
          "description": "Вебхуки для интеграций",
          "models": ["Webhook"],
          "responsibilities": [
            "Создание вебхуков",
            "Фильтрация событий",
            "Отправка HTTP запросов",
            "Retry логика",
            "Логирование"
          ],
          "events": [
            "conversation_created",
            "conversation_updated",
            "message_created",
            "contact_created",
            "agent_assigned"
          ]
        }
      },

      "ai_modules": {
        "captain_system": {
          "description": "Система локального ИИ помощника (Captain)",
          "namespace": "Enterprise::Captain",
          "models": {
            "captain_assistant": {
              "model": "Captain::Assistant",
              "description": "Конфигурация ИИ помощника",
              "attributes": [
                "name - Название помощника",
                "description - Описание функций",
                "config - JSON конфигурация модели",
                "response_guidelines - Инструкции для ответов",
                "guardrails - Ограничения и правила"
              ],
              "responsibilities": [
                "Хранение конфигурации ИИ",
                "Связь с инбоксами",
                "Управление документами базы знаний",
                "Настройки промптов и поведения"
              ]
            },

            "captain_inbox": {
              "model": "CaptainInbox",
              "description": "Связь ИИ помощника с инбоксами",
              "attributes": [
                "captain_assistant_id",
                "inbox_id"
              ],
              "responsibilities": [
                "Привязка помощника к каналам связи",
                "Управление доступом ИИ к разговорам"
              ]
            },

            "captain_document": {
              "model": "Captain::Document",
              "description": "Документы базы знаний для ИИ",
              "attributes": [
                "title - Название документа",
                "content - Текст документа",
                "metadata - Дополнительные данные",
                "status - Статус (active, archived)",
                "embeddings - Векторное представление"
              ],
              "responsibilities": [
                "Хранение контента для обучения ИИ",
                "Векторизация текста (embeddings)",
                "Семантический поиск",
                "Контекстная релевантность"
              ]
            },

            "captain_assistant_response": {
              "model": "Captain::AssistantResponse",
              "description": "Ответы, сгенерированные ИИ",
              "attributes": [
                "conversation_id",
                "message_id",
                "prompt - Исходный запрос",
                "response - Ответ ИИ",
                "status - Статус (pending, completed, failed)",
                "metadata - Метаданные генерации"
              ],
              "responsibilities": [
                "Сохранение истории ИИ взаимодействий",
                "Отслеживание качества ответов",
                "Аналитика использования ИИ"
              ]
            },

            "captain_scenario": {
              "model": "Captain::Scenario",
              "description": "Сценарии использования ИИ",
              "responsibilities": [
                "Предопределенные сценарии ответов",
                "Контекстные промпты",
                "Специализированные use cases"
              ]
            }
          },

          "services": {
            "captain_assistant_service": {
              "description": "Обработка запросов к ИИ",
              "responsibilities": [
                "Формирование промптов",
                "Отправка запросов в Ollama",
                "Обработка ответов",
                "Контекстное дополнение из документов",
                "Error handling и retry"
              ],
              "workflow": [
                "1. Получение запроса от пользователя",
                "2. Загрузка конфигурации Assistant",
                "3. Поиск релевантных документов (vector search)",
                "4. Формирование промпта с контекстом",
                "5. Отправка в Ollama API",
                "6. Получение и валидация ответа",
                "7. Сохранение в AssistantResponse",
                "8. Возврат результата агенту"
              ]
            },

            "document_embedding_service": {
              "description": "Векторизация документов",
              "responsibilities": [
                "Генерация embeddings для документов",
                "Сохранение в pgvector",
                "Обновление векторов при изменении",
                "Семантический поиск"
              ]
            },

            "copilot_service": {
              "description": "ИИ ассистент для агентов",
              "models": ["CopilotThread", "CopilotMessage"],
              "features": [
                "Expand - Расширение краткого текста",
                "Summarize - Резюме разговора",
                "Rephrase - Переформулирование",
                "Fix spelling - Исправление грамматики",
                "Make friendly - Дружелюбный тон",
                "Make formal - Формальный тон",
                "Label suggestions - Предложение меток"
              ],
              "responsibilities": [
                "Помощь агентам в реальном времени",
                "Улучшение качества ответов",
                "Ускорение работы агентов"
              ]
            }
          },

          "api_endpoints": [
            "POST /api/v1/accounts/:account_id/captain/assistants - Создание помощника",
            "GET /api/v1/accounts/:account_id/captain/assistants - Список помощников",
            "POST /api/v1/accounts/:account_id/captain/documents - Загрузка документа",
            "POST /api/v1/accounts/:account_id/captain/assistant_responses - Генерация ответа",
            "GET /api/v1/accounts/:account_id/captain/copilot_threads - История Copilot"
          ],

          "integration_with_ollama": {
            "connection": "HTTP API на http://ollama:11434",
            "model_config": {
              "default_model": "qwen2.5:14b",
              "temperature": 0.7,
              "top_p": 0.9,
              "top_k": 40,
              "context_window": 4096
            },
            "features": [
              "Локальное развертывание - нет отправки данных вовне",
              "Кастомные промпты на русском языке",
              "Низкая задержка ответов",
              "Нет затрат на API"
            ]
          }
        }
      },

      "background_jobs": {
        "description": "Фоновые задачи через Sidekiq",
        "queues": {
          "default": "Общие задачи",
          "mailers": "Отправка email",
          "webhooks": "Обработка вебхуков",
          "integrations": "Синхронизация с внешними API",
          "low": "Низкоприоритетные задачи"
        },
        "common_jobs": [
          "SendEmailJob - Отправка email",
          "WebhookJob - Отправка вебхуков",
          "ConversationReplyEmailJob - Уведомления о новых сообщениях",
          "DataImportJob - Импорт данных",
          "ReportGenerationJob - Генерация отчетов",
          "CaptainDocumentEmbeddingJob - Векторизация документов"
        ]
      },

      "real_time": {
        "websockets": {
          "framework": "Action Cable",
          "channels": [
            "RoomChannel - Обновления разговоров в реальном времени",
            "NotificationChannel - Уведомления агентам",
            "PresenceChannel - Онлайн статус"
          ],
          "events": [
            "message.created",
            "conversation.updated",
            "typing.on",
            "typing.off",
            "presence.update"
          ]
        }
      }
    },

    "frontend": {
      "framework": "Vue.js 3 с Composition API",
      "build_tool": "Vite",
      "styling": "Tailwind CSS",

      "architecture": {
        "type": "SPA (Single Page Application)",
        "routing": "Vue Router",
        "state_management": "Vuex store",
        "api_client": "Axios с interceptors"
      },

      "main_applications": {
        "dashboard": {
          "path": "/app/javascript/dashboard",
          "description": "Панель управления для агентов",
          "routes": {
            "conversations": "/app/accounts/:accountId/conversations",
            "contacts": "/app/accounts/:accountId/contacts",
            "reports": "/app/accounts/:accountId/reports",
            "settings": "/app/accounts/:accountId/settings",
            "captain": "/app/accounts/:accountId/captain"
          },
          "key_components": {
            "conversation_view": {
              "description": "Просмотр и управление разговором",
              "features": [
                "История сообщений",
                "Редактор ответов с rich text",
